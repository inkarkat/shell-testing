#!/bin/bash
shopt -qs extglob
${DEBUG:+eval $(debugtrace -o $- -- "$@")}

readonly scriptDir="$([ "${BASH_SOURCE[0]}" ] && dirname -- "${BASH_SOURCE[0]}" || exit 3)"
[ -d "$scriptDir" ] || { echo >&2 'ERROR: Cannot determine script directory!'; exit 3; }
readonly projectDir="${scriptDir}/.."
readonly libDir="${projectDir}/lib"

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, they can
    # skim the long one.
    printf 'Usage: [TEST_SINK=FILE|&N|"" | TEST_LOGDIR=DIR] %q %s\n' "$(basename "$1")" '[--for TESTEE] [-m|--module MODULE] [-p|--point TEST-POINT-NAME] [--piped] [-?|-h|--help] ...'
    printf 'Usage: eval "$(${TEST:+%q %s} "${TEST:-printf}" "${TEST:- %%q}" %s)"\n' "$(basename "$1")" '... --' 'SIMPLECOMMAND [...]'
    printf 'Usage: eval "$(${TEST:+%q %s} "${TEST:-echo}" %s)"\n' "$(basename "$1")" '... -c|--command' '"COMMANDLINE"'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
If testing is not enabled for the caller, simply print COMMAND so that the
invoking eval executes it normally.
When \$TEST refers plainly to the TESTEE, COMMAND is printed for execution by
the invoking eval and the invocation is recorded. If no MODULE / TEST-POINT-NAME
is targeted, invocations for all MODULEs / TEST-POINT-NAMEs of the TESTEE are
recorded.
\$ TEST=TESTEE[:MODULE][::TEST-POINT-NAME][EXTENSION] TESTEE ...

Extensions:
When \$TEST refers to TESTEE!, COMMAND is NOT printed / executed.
When \$TEST refers to TESTEE=OTHER-COMMAND, OTHER-COMMAND instead of COMMAND
is printed for execution by the invoking eval.
When \$TEST refers to TESTEE@[N-]FILE, the execution uses the contents of
FILE (and an exit status of N) as the output of the skipped COMMAND execution.
This allows the injection of canned output (and exit status).
When \$TEST refers to TESTEE^=PREFIX, PREFIX is put before COMMAND for
execution by the invoking eval.
When \$TEST refers to TESTEE+=SUFFIX, SUFFIX is put after COMMAND for
execution by the invoking eval.
When \$TEST refers to TESTEE?PREDICATE, the invocation of COMMAND is recorded
(and not printed / replaced / embellished according to any other instructions)
only if PREDICATE is successful.

Recording in the format TESTEE[:MODULE][::TEST-POINT-NAME] goes into \$TEST_SINK
/ a log file TESTEE.log inside \$BATS_TEST_TMPDIR (i.e. an ephemeral per-test
directory when running under Bats) / \$TEST_LOGDIR / the current directory.
\$ TEST=test[eval] TESTEE ... will show for what TESTEE it will enable (if not
  actually enabled).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --for TESTEE	Target TESTEE; by default it will take the name of the
			parent process.
    --module|-m MODULE	Activate only if testing for MODULE of the TESTEE is
			enabled.
    --point|-p TEST-POINT-NAME
			Uniquely identify this test point when using multiple
			in the same TESTEE, so that you can have multiple test
			hooks for the same TESTEE and MODULE.
    --piped		Indicate that the COMMAND is part of a pipeline.
			Multiple OTHER-COMMANDs are joined with "|" instead of
			";" then.

SEE ALSO:
- debugeval is a variant that triggers on DEBUG instead of TEST and also writes
  execution traces and supports trace enablement, and is intended for debugging.
HELPTEXT
}

assertSingleCommand()
{
    [ -z "$commands" ] || { printf 'ERROR: COMMAND is allowed only once, but given "%s" and "%s" (minus "%s").\n' "$commands" "$1" "$TEST" >&2; exit 2; }
}

countTestArgs()
{
    if [ -z "$TEST" ]; then
	case "$1" in
	    echo)	printf 1;;
	    printf)	printf 2;;
	    *)		printf 0;;
	esac
    else
	for ((i = 0; i < $#; i++))
	do
	    [ "${*:i+1:1}" = "$TEST" ] || break
	done
	printf %d $i
    fi
}

testee="$TEST_TESTEE"
module=
testPointName=
commands=
commandJoiner=';'
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--for)		shift; testee="${1?}"; shift;;
	--module|-m)	shift; module="${1:?}"; shift;;
	--point|-p)	shift; testPointName="${1:?}"; shift;;
	--piped)	shift; commandJoiner='|';;
	--command|-c)	shift
			assertSingleCommand "$*"
			shift $(countTestArgs "$@")
			commands="${1:?}"; shift
			;;
	--)		shift
			shift $(countTestArgs "$@")
			break
			;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -ne 0 ]; then
    assertSingleCommand "$*"
    shift $(countTestArgs "$@")
    # Need to quote SIMPLECOMMAND to undo the effects of eval.
    printf -v quotedSimpleCommand '%q ' "$@"
    commands="${quotedSimpleCommand% }"
fi
if [ -z "$commands" ]; then
    echo "ERROR: No COMMAND(s) specified; need to pass -c|--command \"COMMANDLINE\", or SIMPLECOMMAND."
    echo
    printUsage "$0"
    exit 2
fi >&2

passthroughCommands()
{
    printf %s "$commands"
}

if [ -z "$TEST" ]; then
    passthroughCommands
    exit 0
fi

source "${libDir}/directiveParser.sh" || exit 3

record()
{
    local redir
    case "$TEST_SINK" in
	'')	    printf -v redir '>>%q' "${BATS_TEST_TMPDIR:-${TEST_LOGDIR-$PWD}}/${testee}.log";;
	\&+([0-9])) redir=">$TEST_SINK";;
	?*)	    printf -v redir '>>%q' "$TEST_SINK";;
    esac

    eval "printf '%s%s%s\\n' \"\$testee\" \"\${module:+:}\${module}\" \"\${testPointName:+::}\${testPointName}\" $redir"
}

passthroughCommandsAndRecord()
{
    record
    passthroughCommands
}

readonly scriptName="$(basename -- "${BASH_SOURCE[0]}")"
if [ -z "$testee" ]; then
    {
	IFS= read -r -d '' testCmd
	IFS= read -r -d '' testSecond
    } < /proc/${PPID}/cmdline
    testee="$(commandName --no-interpreter --undefined "$scriptName" -- "$testCmd" "$testSecond")"
fi

isActive=
action=

hadPredicate=; while testConsumeDirectiveInto predicate '?'; do
    hadPredicate=t
    if [ -z "$predicate" ]; then
	isActive=t
    elif eval "($predicate)"; then
	isActive=t
    fi
done
if [ "$hadPredicate" ] && [ ! "$isActive" ]; then
    passthroughCommands
    exit 0
fi

case ",${TEST}," in
    *,"${testee}${module:+:}${module}${testPointName:+::}${testPointName}",*)
	isActive=t
	;;
    *,"${testee}${module:+:}${module}${testPointName:+::}${testPointName}!",*)
	isActive=t
	action=record
	;;
    *)
	hasOtherCommand=
	while testConsumeDirectiveInto otherCommand '='; do
	    isActive=t
	    if [ -z "$otherCommand" ]; then
		printf >&2 '%s: Warning: Empty OTHER-COMMAND given for %q (better use TESTEE!)\n' "$scriptName" "${testee}${module:+:}${module}${testPointName:+::}${testPointName}"
	    else
		[ "$hasOtherCommand" ] || commands=''
		commands+="${commands:+$commandJoiner }${otherCommand}"
		hasOtherCommand=t
	    fi
	done

	previousFilespec=
	while testConsumeDirectiveInto filespec '@'; do
	    isActive=t

	    eval "expandedFilespec=$filespec" # Expand environment variables and tilde.
	    if [ -n "$expandedFilespec" ]; then
		exitStatus=
		if [[ "$expandedFilespec" =~ ^(.*/)?([0-9]+)-(.+)$ ]]; then
		    exitStatus="${BASH_REMATCH[2]}"
		    expandedFilespec="${BASH_REMATCH[1]}${BASH_REMATCH[3]}"
		fi
		if [ -e "$expandedFilespec" ]; then
		    isActive=t
		    if [ -n "$previousFilespec" ]; then
			printf >&2 '%s: Warning: Duplicate @%s given for %q\n' "$scriptName" "$previousFilespec" "${testee}${module:+:}${module}${testPointName:+::}${testPointName}"
			actions[-1]="outputting ${expandedFilespec}${exitStatus:+ and exiting with $exitStatus}"
		    else
			actions+=("outputting ${expandedFilespec}${exitStatus:+ and exiting with $exitStatus}")
		    fi
		    printf -v commands '%scat %q%s' "${exitStatus:+(}" "$expandedFilespec" "${exitStatus:+; exit ${exitStatus})}"
		    previousFilespec="$filespec"
		else
		    printf >&2 '%s: Warning: Non-existing FILE given for %q; ignoring: %s\n' "$scriptName" "${testee}${module:+:}${module}${testPointName:+::}${testPointName}" "$filespec"
		fi
	    else
		printf >&2 '%s: Warning: No FILE given for %q; ignoring.\n' "$scriptName" "${testee}${module:+:}${module}${testPointName:+::}${testPointName}"
	    fi
	done
	;;
esac

# We can only embellish the COMMAND if it's still to be executed (i.e.
# not disabled by the ! case).
if [ -z "$action" ]; then
    while testConsumeDirectiveInto prefix '^='
    do
	isActive=t
	commands="${prefix}${commands}"
	[ -z "$prefix" ] && printf >&2 '%s: Warning: Empty PREFIX given for %q\n' "$scriptName" "${testee}${module:+:}${module}${testPointName:+::}${testPointName}"
    done
    while testConsumeDirectiveInto suffix '+='
    do
	isActive=t
	commands+="$suffix"
	[ -z "$suffix" ] && printf >&2 '%s: Warning: Empty SUFFIX given for %q\n' "$scriptName" "${testee}${module:+:}${module}${testPointName:+::}${testPointName}"
    done
fi

# For recording, the MODULE and TEST-POINT-NAME are optional.
if [ ! "$isActive" ]; then
    case ",${TEST}," in
	*,"${testee}${module:+:}${module}",*)
	    # Accept any TEST-POINT-NAME if the TESTEE and MODULE match.
	    [ -n "$testPointName" ] && isActive=t
	    ;;
	*,"${testee}",*)
	    # Accept any MODULE if the TESTEE matches.
	    [ -n "$module" ] && isActive=t
	    ;;
    esac
fi

# For recording, the ?PREDICATE should also be tested if MODULE and/or
# TEST-POINT-NAME are not targeted.
TEST+=,	# Allow anchoring replacements at the end.
if [ ! "$isActive" -a -n "$testPointName" ]; then
    # Ignore the TEST-POINT-NAME and check for a predicate for the TESTEE and
    # MODULE.
    hadPredicate=; while TEST="${TEST//${testee}${module:+:}${module}::${testPointName},/${testee}${module:+:}${module},}" testPointName='' testConsumeDirectiveInto predicate '?'; do
	hadPredicate=t
	if [ -z "$predicate" ]; then
	    isActive=t
	elif eval "($predicate)"; then
	    isActive=t
	fi
    done
fi
if [ ! "$isActive" -a -n "$module" ]; then
    # Ignore MODULE and TEST-POINT-NAME and check for a predicate for the TESTEE.
    hadPredicate=; while TEST="${TEST//${testee}:${module},/${testee},}" module='' testPointName='' testConsumeDirectiveInto predicate '?'; do
	hadPredicate=t
	if [ -z "$predicate" ]; then
	    isActive=t
	elif eval "($predicate)"; then
	    isActive=t
	fi
    done
fi

if [ "$isActive" ]; then
    ${action:-passthroughCommandsAndRecord}
else
    case ",${TEST}," in
	*,@(test|${scriptName}),*)
	    quotedModule=; [ -n "$module" ] && printf -v quotedModule %q "$module"
	    quotedTestPointName=; [ -n "$testPointName" ] && printf -v quotedTestPointName %q "$testPointName"
	    printf >&2 '%s: Will activate with TEST=%q%s%s\n' "$scriptName" "${testee}" "${module:+:}${quotedModule}${testPointName:+::}${quotedTestPointName}" '[!|=OTHER-COMMAND|@[N-]FILE|^=PREFIX|+=SUFFIX|?PREDICATE]'
	    ;;
    esac

    passthroughCommands
fi
